{
  "name": "docvex",
  "productName": "DocVex",
  "version": "11.0.1",
  "description": "My Electron application description",
  "main": ".vite/build/main.js",
  "private": true,
  "scripts": {
    "prestart": "node scripts/dev-rename-electron.mjs",
    "postinstall": "node scripts/copy-ocr-assets.mjs && node scripts/copy-whisper-assets.mjs",
    "start": "electron-forge start",
    "start:multi": "node scripts/run-many.mjs",
    "package": "electron-forge package",
    "make": "electron-forge make",
    "publish": "node scripts/check-signing.mjs && electron-forge publish",
    "preversion": "(git diff-index --quiet HEAD -- || (echo Commit or stash changes before releasing && exit 1)) && node scripts/check-signing.mjs",
    "version": "node scripts/sync-readme-version.mjs && node scripts/release-upload-page.mjs",
    "postversion": "node scripts/post-release.mjs",
    "release:patch": "npm version patch -m \"chore(release): %s\"",
    "release:minor": "npm version minor -m \"chore(release): %s\"",
    "release:major": "npm version major -m \"chore(release): %s\"",
    "fix:mac": "node scripts/fix-mac-release.mjs",
    "site:dev": "vite --config vite.site.config.mjs --open",
    "site:deploy": "node scripts/landing-deploy.mjs",
    "site:upload-page": "node scripts/build-upload-page.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:index": "node scripts/test-index.mjs",
    "check:vertex": "node scripts/check-vertex.mjs",
    "check:storage": "node scripts/check-localstorage.mjs",
    "lint": "echo \"No linting configured\""
  },
  "keywords": [],
  "author": {
    "name": "PetreLuca05",
    "email": "petreluca1105@gmail.com"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/petreluca1105-dotcom/docvex.git"
  },
  "devDependencies": {
    "@electron-forge/cli": "^7.11.1",
    "@electron-forge/maker-deb": "^7.11.1",
    "@electron-forge/maker-dmg": "^7.11.2",
    "@electron-forge/maker-rpm": "^7.11.1",
    "@electron-forge/maker-squirrel": "^7.11.1",
    "@electron-forge/maker-zip": "^7.11.1",
    "@electron-forge/plugin-auto-unpack-natives": "^7.11.1",
    "@electron-forge/plugin-fuses": "^7.11.1",
    "@electron-forge/plugin-vite": "^7.11.1",
    "@electron-forge/publisher-github": "^7.11.1",
    "@electron/fuses": "^1.8.0",
    "@vitejs/plugin-react": "^4.7.0",
    "archiver": "^8.0.0",
    "electron": "^42.11.10",
    "vite": "^5.4.21"
  },
  "dependencies": {
    "@fontsource/cinzel": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/plus-jakarta-sans": "^5.3.0",
    "@huggingface/transformers": "^4.3.0",
    "@noble/ciphers": "^2.4.0",
    "@supabase/supabase-js": "^2.105.4",
    "@tesseract.js-data/eng": "^1.0.0",
    "@tesseract.js-data/ron": "^1.0.0",
    "@zxing/library": "^0.21.3",
    "country-flag-icons": "^1.6.20",
    "docx": "^9.7.1",
    "docx-preview": "^0.3.7",
    "electron-squirrel-startup": "^1.0.1",
    "extract-zip": "^2.0.1",
    "heic-to": "^1.5.2",
    "html2canvas": "^1.4.1",
    "jspdf": "^4.2.1",
    "jszip": "^3.10.1",
    "libphonenumber-js": "^1.13.13",
    "onnxruntime-web": "^1.30.0",
    "paddleocr": "^1.2.0",
    "pdfjs-dist": "^5.7.284",
    "pptxgenjs": "^4.0.1",
    "qrcode": "^1.5.4",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.15.0",
    "remark-gfm": "^4.0.1",
    "tesseract.js": "^7.0.0",
    "update-electron-app": "^3.2.0",
    "word-extractor": "^1.0.4",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "yauzl": "^2.10.0"
  },
  "overrides": {
    "pptxgenjs": {
      "image-size": "^2.0.4"
    }
  }
}
